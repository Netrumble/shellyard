{
  "name": "shellyard-desktop",
  "productName": "ShellYard",
  "version": "0.1.0",
  "description": "ShellYard as a desktop app: the same terminals and Claude Code sessions in their own window instead of a browser tab.",
  "type": "module",
  "main": "main.js",
  "bin": {
    "shellyard-desktop": "bin/shellyard-desktop.js"
  },
  "files": [
    "bin",
    "main.js",
    "find-node.js",
    "icon.png",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "installer": "node scripts/build-installer.mjs"
  },
  "keywords": [
    "claude-code",
    "terminal",
    "electron",
    "desktop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talentia-Software-OSS/shellyard.git",
    "directory": "desktop"
  },
  "license": "MIT",
  "dependencies": {
    "electron": "^45.3.4",
    "shellyard": "^0.1.0"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0"
  }
}
