{
  "name": "console-view-manager",
  "version": "0.1.0",
  "description": "Manage Claude Code and shell terminals from a local browser UI, and see which one needs you.",
  "type": "module",
  "bin": {
    "ttc": "dist/cli/cvm.js",
    "cvm": "dist/cli/cvm.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:server": "tsx src/cli/cvm.ts --foreground",
    "dev:web": "vite",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "claude-code",
    "terminal",
    "pty",
    "xterm"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "open": "^11.0.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
